rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUser().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isExcom() {
      return hasRole('excom') || isAdmin();
    }

    function isVolunteer() {
      return isSignedIn();
    }

    function isSameChapter(chapterCode) {
      return getUser().chapterCode == chapterCode;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile; admins can read all
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Users can update limited fields of their own profile
      allow update: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'totalHours', 'activeOCCount']);
      // Only admins can create/delete users
      allow create, delete: if isAdmin();
      // Excom can read members in their chapter
      allow read: if isExcom() && isSameChapter(resource.data.chapterCode);
    }

    // ── Chapters ───────────────────────────────────────────────────────────
    match /chapters/{chapterCode} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Events ─────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      // Excom can create/update events in their chapter
      allow create: if isExcom();
      allow update: if isExcom() && isSameChapter(resource.data.chapterCode);
      allow delete: if isAdmin();
    }

    // ── Engagements ────────────────────────────────────────────────────────
    match /engagements/{engagementId} {
      // Volunteers can read their own; excom/admin can read all in chapter
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isExcom()
      );
      // Volunteers can create their own engagements (join event)
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Excom can update (verify hours, change status); volunteer can drop own
      allow update: if isExcom() ||
        (isSignedIn() && resource.data.userId == request.auth.uid
         && request.resource.data.status == 'dropped');
      allow delete: if isAdmin();
    }

    // ── Service Letters ────────────────────────────────────────────────────
    match /serviceLetters/{letterId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Volunteers can request their own letters
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only admins can approve/reject
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
